    "n": 3,
    "required": true,
    "pages": [
      "index"
    ],
    "templates": [
      "landing"
    ]
  },
  "feature-row": {
    "origin": ".alternating-rows-triangle",
    "build": ".feature-row",
    "n": 2,
    "required": true,
    "pages": [
      "index"
    ],
    "templates": [
      "landing"
    ]
  },
  "insights-post-tile": {
    "origin": "#insights-section .featured-post",
